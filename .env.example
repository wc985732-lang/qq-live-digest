# ===== 官方 QQ 机器人（可选，默认关闭；当前主链路用 NapCat/OneBot）=====
# 设为 1 才启用官方 QQ 机器人；当前部署使用 NapCat，保持 0 即可。
QQ_DIGEST_OFFICIAL_BOT_ENABLED=0
QQ_BOT_APPID=
QQ_BOT_SECRET=
# 沙箱环境填 1，正式环境填 0
QQ_BOT_SANDBOX=1
# 只监听这几个群（NapCat 填 QQ 群号；官方 Bot 填 group_openid，逗号分隔）
# 必填：留空 = 不处理任何群（fail-closed），不会默认接收全部群。
# 示例：QQ_DIGEST_GROUPS=123456789,987654321
QQ_DIGEST_GROUPS=
# 群号/openid 到中文名的映射，便于阅读：123456=学院通知群,789012=班级群
QQ_DIGEST_GROUP_ALIASES=
# 低优先级/闲聊群（群号或 openid，逗号分隔）：不触发紧急立即推，普通讨论不入摘要/待办
QQ_DIGEST_QUIET_GROUPS=
# 群级策略（JSON，键写群号或群名；没写的字段继承全局）。示例：
# QQ_DIGEST_GROUP_POLICIES={"123456": {"quiet": true, "min_score": 5, "keywords": ["考试"]}, "学院通知群": {"model": "light", "quiet_hours": "23:00-06:30"}}
QQ_DIGEST_GROUP_POLICIES=
# 即时处理群（群号或 openid，逗号分隔）：不等合并窗口，来消息后下一轮直接处理，适合测试群
QQ_DIGEST_IMMEDIATE_GROUPS=
# 推送目标：先私聊机器人一次，把日志里 C2C_MESSAGE_CREATE 的 user_openid 填进来
QQ_DIGEST_PUSH_OPENIDS=

# ===== 备用推送通道（QQ 私聊失败时自动回退，至少配一个）=====
# WxPusher：https://wxpusher.zjiecode.com/docs/ （微信接收）
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
WXPUSHER_TOPIC_IDS=
# Server酱：https://sct.ftqq.com/ （微信接收）
SERVERCHAN_KEYS=
# PushPlus：https://www.pushplus.plus/ （支持 QQ 机器人通道）
PUSHPLUS_TOKENS=
# 通用 Webhook（POST JSON: title/content/source）
QQ_DIGEST_WEBHOOKS=

# ===== 大模型精炼（可选；不填则用本地规则筛选）=====
DASHSCOPE_API_KEY=
QQ_DIGEST_LLM=1
# 模型 Provider：openai-compat=任何 OpenAI 兼容端点（默认）；none=关闭模型调用
QQ_DIGEST_LLM_PROVIDER=openai-compat
QQ_DIGEST_LLM_MODEL=qwen3.8-max
QQ_DIGEST_LLM_TIMEOUT=60
QQ_DIGEST_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 推送里是否附带原文；0=只发 AI/本地精简摘要（推荐）
QQ_DIGEST_INCLUDE_RAW=0
# 大模型失败时的重试与降级：先原地重试，仍可恢复则推迟这一批，超上限才用本地规则。
QQ_DIGEST_LLM_MAX_RETRIES=2
QQ_DIGEST_LLM_RETRY_BACKOFF=1.5
QQ_DIGEST_LLM_DEFER_MAX_ATTEMPTS=3
QQ_DIGEST_LLM_DEFER_WINDOW_MINUTES=15
# 模型用量 / 成本（A5）：单价按「元 / 百万 token」填，只影响 main.py llm-stats 的费用折算；
# 留空或填 0 时只统计 token，不折算费用。
QQ_DIGEST_LLM_PRICE_IN=0
QQ_DIGEST_LLM_PRICE_OUT=0

# 模型分级路由（A6）：填了轻量模型就按「规则 → 轻量 → 高能力」分流，并把路由原因记进 llm_calls。
# 留空 = 不启用分级，一切照旧走高能力模型（行为与 A6 之前一致）。
QQ_DIGEST_LLM_MODEL_LIGHT=
# 候选超过这个条数就算难例，直接交给高能力模型。
QQ_DIGEST_LLM_ROUTE_MAX_LIGHT_ITEMS=6
# 打开后：条数很少且都已高置信的批次干脆不调模型，用本地规则交付（默认关闭）。
QQ_DIGEST_LLM_ROUTE_EASY_LOCAL=0

# 推送卡片：HTML 色块突出待办/紧急，通知栏用一句话摘要
QQ_DIGEST_PUSH_HTML=1
# 推送预算与夜间静默：非紧急推送统一限流，紧急事项始终放行。
# 预算设为 0 表示不限量；静默时段留空表示关闭。
QQ_DIGEST_PUSH_DAILY_BUDGET=12
QQ_DIGEST_QUIET_HOURS=23:00-07:00
# 截止提醒：早上看今天到期，晚上提前看明天到期
QQ_DIGEST_DEADLINE_REMINDERS=1
QQ_DIGEST_DEADLINE_MORNING=07:30
QQ_DIGEST_DEADLINE_EVENING=21:00

# 事务闭环：候选确认卡（模糊行动项先确认）和每周复盘
QQ_DIGEST_CANDIDATE_PUSH=1
QQ_DIGEST_CANDIDATE_MIN_CONFIDENCE=0.55
QQ_DIGEST_CANDIDATE_REMINDER_HOURS=24
QQ_DIGEST_CANDIDATE_MAX_PER_TICK=2
QQ_DIGEST_CANDIDATE_MAX_PER_DAY=4
QQ_DIGEST_WEEKLY_REVIEW=1
# Python weekday: 0=周一, 6=周日
QQ_DIGEST_WEEKLY_REVIEW_WEEKDAY=6
QQ_DIGEST_WEEKLY_REVIEW_TIME=20:30

# 手机端待办台：Tailscale 或局域网访问；token 留空会自动生成
QQ_DIGEST_WEB=1
QQ_DIGEST_WEB_HOST=0.0.0.0
QQ_DIGEST_WEB_PORT=8766
# 可选：固定外部访问地址，例如 Tailscale Serve 的 HTTPS 地址
# QQ_DIGEST_WEB_BASE_URL=https://your-machine.your-tailnet.ts.net
QQ_DIGEST_WEB_TOKEN=

# ===== 调度参数 =====
# 普通通知合并窗口（分钟）
QQ_DIGEST_WINDOW_MINUTES=30
# 轮询间隔（秒）
QQ_DIGEST_POLL_SECONDS=20
# 紧急通知是否立即推送
QQ_DIGEST_URGENT_IMMEDIATE=1
# 分数阈值：越高越只推重要通知（建议 3）
QQ_DIGEST_MIN_SCORE=3
QQ_DIGEST_MAX_ITEMS=30
# 投递失败重试
QQ_DIGEST_MAX_ATTEMPTS=4
QQ_DIGEST_RETRY_SECONDS=90
QQ_DIGEST_RETENTION_DAYS=30

# ===== 主方案：NapCat/LLOneBot 的 OneBot v11 HTTP 上报 =====
QQ_DIGEST_ONEBOT_ENABLED=1
QQ_DIGEST_ONEBOT_HOST=127.0.0.1
QQ_DIGEST_ONEBOT_PORT=8765
QQ_DIGEST_ONEBOT_TOKEN=

# NapCat HTTP API（补采历史消息用；token 留空时自动复用上面的 OneBot token）
QQ_DIGEST_NAPCAT_API_URL=http://127.0.0.1:3000
QQ_DIGEST_NAPCAT_API_TOKEN=

# 历史补采：服务启动时及每隔 N 分钟，从 NapCat 拉取最近消息补齐断点
QQ_DIGEST_CATCHUP_ENABLED=1
QQ_DIGEST_CATCHUP_HOURS=24
QQ_DIGEST_CATCHUP_COUNT=50
QQ_DIGEST_CATCHUP_INTERVAL_MINUTES=30

# 数据与日志目录（默认项目下 data/ 和 logs/）
QQ_DIGEST_DATA_DIR=
QQ_DIGEST_LOG_DIR=

# 群文件 / 群图片：AI 读取文件和截图里的通知
QQ_DIGEST_ATTACHMENTS=1
QQ_DIGEST_ATTACHMENT_MAX_MB=10
QQ_DIGEST_ATTACHMENT_MAX_PER_HOUR=30
QQ_DIGEST_ATTACHMENT_RETENTION_DAYS=7
QQ_DIGEST_VISION=1
QQ_DIGEST_VL_MODEL=qwen3-vl-plus
QQ_DIGEST_DOCUMENT_MAX_CHARS=30000
QQ_DIGEST_PDF_OCR_MAX_PAGES=20
# 多少小时内推过的同一条通知不再重复推（班级群/闲聊群转发重复），0=关闭
QQ_DIGEST_DEDUPE_HOURS=6
# 事件级跨群聚合：把同一事件（对象+动作+时间+截止+来源）在多个群的转发合成一条；0=关闭（默认）
QQ_DIGEST_EVENT_MERGE=0
